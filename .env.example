# Copy this file to .env. Every value below is safe to keep as it is: the tests and `make replay` run with an
# unchanged copy. Fill in a line only where the comment above it says the run needs it. README "Configuration"
# describes every setting; an unknown key in .env fails validation, so a typo fails fast.

# Required in every mode: the address that receives the report. One plain address. The placeholder is valid, so
# replay and the tests work with the file as copied; a live run sends to whatever is written here.
AGENT_EMAIL_TO=you@example.com

# Required for live runs (nasdaq-agent run). The default model, its judge and its fallback are all on OpenRouter,
# pay-as-you-go, so the account needs credit. Replay needs no key.
OPENROUTER_API_KEY=

# Optional data sources. Each one adds a source when set; empty keeps it off. README "Live" says what each adds.
# Massive: the first gainer source, the price cross-check, news, and the NASDAQ list of a past day. Free key.
MASSIVE_API_KEY=
# Alpha Vantage: the second gainer source, limited to 25 requests a day. Free key.
ALPHAVANTAGE_API_KEY=
# SEC EDGAR filings as a news source. SEC asks automated clients to declare a name and contact email, such as
# "Jane Doe jane@example.com"; it is sent only to SEC. Empty keeps the source off.
AGENT_SEC_USER_AGENT=

# Email delivery. With AGENT_SMTP_HOST blank, each email is written to runs/<run_id>/outbox/ as an .eml file.
# Setting the host selects SMTP, and then AGENT_SMTP_USERNAME, AGENT_SMTP_PASSWORD and AGENT_SMTP_FROM are all
# required. Any relay with STARTTLS works, including Gmail with an app password. Replay always writes to the outbox.
# AGENT_EMAIL_TRANSPORT is auto, smtp or file; auto picks SMTP when the host is set.
AGENT_EMAIL_TRANSPORT=auto
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USERNAME=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=
AGENT_SMTP_STARTTLS=true

# Models, as provider:model. Leave these three as they are for replay: the recorded replies are filed under the
# model names, so a different judge model makes replay fail with "no recorded model response".
AGENT_LLM_MODEL=openrouter:z-ai/glm-5.3
AGENT_LLM_JUDGE_MODEL=openrouter:moonshotai/kimi-k3
AGENT_LLM_FALLBACK_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# Keys for other providers, needed only when a model above is named with google_genai: or anthropic:.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Run choices. AGENT_MODE is live, replay or record; the replay and record commands set it themselves, and
# nasdaq-agent schedule refuses anything but live, so leave it.
AGENT_MODE=live
# auto and docker stop the run at setup when Docker or the sandbox image is missing. subprocess runs the model's code
# in the weaker subprocess sandbox, which screens it but does not isolate it; only this explicit choice selects it.
AGENT_SANDBOX_BACKEND=auto
# The trading day to report on, as YYYY-MM-DD, for a past session: the run's clock is pinned to 16:30 New York time
# that day. Empty reports the last completed session. Leave it empty for nasdaq-agent schedule, which refuses it.
AGENT_SESSION_DATE=

# nasdaq-agent schedule: a standard five-field crontab expression, read in the time zone below. The defaults fire at
# 16:30 New York time, Monday to Friday, half an hour after the close.
AGENT_SCHEDULE_CRON=30 16 * * 1-5
AGENT_SCHEDULE_TIMEZONE=America/New_York

# Tuning. These are the defaults; a run works without changing any of them.
AGENT_LLM_CALL_DELAY_SECONDS=4
AGENT_LLM_TIMEOUT_SECONDS=90
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_MAX_OUTPUT_TOKENS=16384
AGENT_MAX_MODEL_CALLS=25
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_CODE_RUNS=6
AGENT_LOOKBACK_SESSIONS=5
AGENT_NEWS_LOOKBACK_DAYS=3
AGENT_BENCHMARK_SYMBOL=SPY
AGENT_ARTIFACTS_DIR=./runs
AGENT_CASSETTE_DIR=./fixtures/cassettes
AGENT_RUN_DEADLINE_SECONDS=600
AGENT_HTTP_CONNECT_TIMEOUT=5
AGENT_HTTP_READ_TIMEOUT=10

# Optional LangSmith tracing. LangChain reads these from the process environment, so export them in the shell; a
# value set only here is accepted but not passed on. Replay turns tracing off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nasdaq-agent
