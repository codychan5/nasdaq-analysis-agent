AGENT_LLM_MODEL=openrouter:z-ai/glm-5.3
AGENT_LLM_JUDGE_MODEL=openrouter:moonshotai/kimi-k3
AGENT_LLM_FALLBACK_MODEL=openrouter:deepseek/deepseek-v4.1-flash
AGENT_LLM_CALL_DELAY_SECONDS=4
AGENT_LLM_TIMEOUT_SECONDS=90
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_MAX_OUTPUT_TOKENS=8192
AGENT_MAX_MODEL_CALLS=25
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_CODE_RUNS=6
AGENT_MODE=live
AGENT_SANDBOX_BACKEND=auto
AGENT_EMAIL_TRANSPORT=auto
AGENT_EMAIL_TO=you@example.com
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USERNAME=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=
AGENT_SMTP_STARTTLS=true
AGENT_LOOKBACK_SESSIONS=5
AGENT_NEWS_LOOKBACK_DAYS=3
# SEC EDGAR filings as a news source. SEC asks automated clients to declare a name and contact email, such as
# "Jane Doe jane@example.com"; it is sent only to SEC. Empty keeps the source off.
AGENT_SEC_USER_AGENT=
# nasdaq-agent schedule: a standard five-field crontab expression, read in the time zone below.
AGENT_SCHEDULE_CRON=30 16 * * 1-5
AGENT_SCHEDULE_TIMEZONE=America/New_York
AGENT_BENCHMARK_SYMBOL=SPY
AGENT_ARTIFACTS_DIR=./runs
AGENT_CASSETTE_DIR=./fixtures/cassettes
AGENT_RUN_DEADLINE_SECONDS=600
AGENT_HTTP_CONNECT_TIMEOUT=5
AGENT_HTTP_READ_TIMEOUT=10
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MASSIVE_API_KEY=
ALPHAVANTAGE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nasdaq-agent
