# Pin the base by digest before release: python:3.12-slim@sha256:<digest from `docker pull python:3.12-slim`>
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
# The pinned environment (constraints.txt): the same versions record, replay and CI use.
COPY constraints.txt ./
COPY nasdaq_agent ./nasdaq_agent
RUN pip install --no-cache-dir -c constraints.txt .

# Non-root: this container runs model-written analysis code via the subprocess sandbox
# backend, so it is the outer security boundary and must not run as root.
RUN useradd --uid 10001 --create-home agent

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache

RUN mkdir -p /runs && chown agent:agent /runs

USER agent
ENTRYPOINT ["nasdaq-agent"]
CMD ["run"]
